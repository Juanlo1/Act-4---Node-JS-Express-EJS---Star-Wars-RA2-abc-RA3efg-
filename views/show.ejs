<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title><%= starwar.name %></title>
    <link rel="stylesheet" href="/portada.css">
</head>
<body>
    <p><a href="/starwars">Volver al listado</a></p>

    <h1><%= starwar.name %></h1>
    <img src="<%= starwar.photo %>" alt="<%= starwar.name %>" width="220">

    <p><strong>Altura:</strong> <%= starwar.height %> cm</p>
    <p><strong>Peso:</strong> <%= starwar.mass %> kg</p>

    <% if (planeta) { %>
        <h3>Planeta de origen: <%= planeta.name %></h3>
        <p><strong>Periodo de rotacion:</strong> <%= planeta.rotation_period %></p>
        <p><strong>Periodo orbital:</strong> <%= planeta.orbital_period %></p>
    <% } %>

    <br>
    <!-- Botón Editar -->
    <a href="/starwars/<%= encodeURIComponent(starwar.name) %>/edit">
        <button type="button">Editar</button>
    </a>

    <!-- Botón Eliminar -->
    <form action="/starwars/<%= encodeURIComponent(starwar.name) %>?_method=DELETE" method="POST" style="display:inline;">
        <button type="submit">Eliminar</button>
    </form>
</body>
</html>